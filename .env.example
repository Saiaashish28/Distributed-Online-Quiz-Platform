# ---------------------------------------------------------------- backend (Spring Boot)
# JDBC URL, or a provider URL like postgres://user:pass@host:5432/db?sslmode=require
# (converted to JDBC automatically). Defaults to the docker-compose database.
DATABASE_URL=jdbc:postgresql://localhost:5432/quizsphere
DATABASE_USERNAME=quizsphere
DATABASE_PASSWORD=quizsphere

# Required outside local development: a long random string (e.g. `openssl rand -base64 48`).
JWT_SECRET_KEY=
JWT_EXPIRATION_MINUTES=720

# Comma-separated list of allowed browser origins (CORS + WebSocket).
FRONTEND_ORIGIN=http://localhost:5173

# Admin self-registration requires this invite code; leave empty to disable it.
ADMIN_INVITE_CODE=
STUDENT_SELF_REGISTRATION_ENABLED=true

# Optional: create the first admin at startup if no admin exists. Never commit real values.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator

# Seconds of latency tolerated for saves/submits after an attempt's deadline.
QUIZ_GRACE_SECONDS=5
QUIZ_AUTO_SUBMIT_INTERVAL_MS=10000
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_JOIN_PER_MINUTE=20
API_DOCS_ENABLED=true

# ---------------------------------------------------------------- frontend (Vite, build time)
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_BASE_URL=ws://localhost:8080
